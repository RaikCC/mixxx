<!--
Description:
  One deck's bar position display: four lying rectangles, the one for the bar
  currently being played is lit. Hidden as long as the deck's track has no
  downbeat, but the row keeps its space so every deck always occupies the same
  line - that is what makes two decks comparable at a glance.
Variables:
  ChanNum : deck number
-->
<Template>
  <WidgetGroup><!-- fixed slot, keeps the line even while the row is hidden -->
    <ObjectName>DownbeatRowSlot</ObjectName>
    <Layout>horizontal</Layout>
    <Size>62f,4f</Size>
    <Children>

      <WidgetGroup>
        <ObjectName>DownbeatRow</ObjectName>
        <Layout>horizontal</Layout>
        <Size>62f,4f</Size>
        <Children>

          <WidgetGroup>
            <ObjectName>DownbeatSegment</ObjectName>
            <Size>14f,4f</Size>
            <Connection>
              <ConfigKey>[Channel<Variable name="ChanNum"/>],downbeat_phase</ConfigKey>
              <Transform><IsEqual>0</IsEqual></Transform>
              <BindProperty>highlight</BindProperty>
            </Connection>
          </WidgetGroup>

          <WidgetGroup>
            <ObjectName>DownbeatSegment</ObjectName>
            <Size>14f,4f</Size>
            <Connection>
              <ConfigKey>[Channel<Variable name="ChanNum"/>],downbeat_phase</ConfigKey>
              <Transform><IsEqual>1</IsEqual></Transform>
              <BindProperty>highlight</BindProperty>
            </Connection>
          </WidgetGroup>

          <WidgetGroup>
            <ObjectName>DownbeatSegment</ObjectName>
            <Size>14f,4f</Size>
            <Connection>
              <ConfigKey>[Channel<Variable name="ChanNum"/>],downbeat_phase</ConfigKey>
              <Transform><IsEqual>2</IsEqual></Transform>
              <BindProperty>highlight</BindProperty>
            </Connection>
          </WidgetGroup>

          <WidgetGroup>
            <ObjectName>DownbeatSegment</ObjectName>
            <Size>14f,4f</Size>
            <Connection>
              <ConfigKey>[Channel<Variable name="ChanNum"/>],downbeat_phase</ConfigKey>
              <Transform><IsEqual>3</IsEqual></Transform>
              <BindProperty>highlight</BindProperty>
            </Connection>
          </WidgetGroup>

        </Children>
        <Connection>
          <ConfigKey>[Channel<Variable name="ChanNum"/>],downbeat_active</ConfigKey>
          <BindProperty>visible</BindProperty>
        </Connection>
      </WidgetGroup><!-- /DownbeatRow -->

    </Children>
  </WidgetGroup><!-- /DownbeatRowSlot -->
</Template>
